# ---------------------------------------------------------------------------
# AcademyOS — repository ignore rules
# ---------------------------------------------------------------------------

# --- Secrets & environment -------------------------------------------------
# Never commit real configuration. server/.env.example is the documented
# template and is deliberately allowed back in below.
.env
.env.*
*.env
!.env.example
!**/.env.example

# Credential material of any kind
*.pem
*.key
*.p12
*.pfx
*.keystore
*.jks
secrets.json
credentials.json
serviceAccount*.json
gha-creds-*.json
.npmrc
.netrc
.git-credentials

# Cloud / provider CLI state
.aws/
.gcloud/
.azure/

# --- Dependencies ----------------------------------------------------------
node_modules/
.pnp
.pnp.js
jspm_packages/
bower_components/

# --- Build output ----------------------------------------------------------
dist/
dist-ssr/
build/
out/
.output/
.vite/
*.tsbuildinfo

# --- Test / coverage -------------------------------------------------------
coverage/
.nyc_output/
test-results/
playwright-report/
blob-report/
.playwright/
playwright/.cache/

# --- Logs ------------------------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- Runtime data ----------------------------------------------------------
pids/
*.pid
*.seed
*.pid.lock

# --- Uploaded / generated media (binaries never belong in git) -------------
server/storage/
server/uploads/
uploads/

# --- Local database files --------------------------------------------------
data/
mongo-data/
*.sqlite
*.sqlite3
*.db

# --- Caches ----------------------------------------------------------------
.cache/
.parcel-cache/
.eslintcache
.stylelintcache
.npm/
.yarn/cache
.turbo/

# --- Editors & OS ----------------------------------------------------------
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini
