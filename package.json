{
  "name": "academyos",
  "version": "1.0.0",
  "private": true,
  "description": "AcademyOS — multi-tenant SaaS (CRM + LMS + academy management) deployed as a single Vercel project: Vite SPA plus the Express API as a serverless function.",
  "engines": {
    "node": ">=20 <23"
  },
  "scripts": {
    "build": "npm --prefix client ci && npm --prefix client run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev:api": "npm --prefix server run dev",
    "dev:web": "npm --prefix client run dev",
    "test": "npm --prefix server test",
    "seed": "npm --prefix server run seed"
  },
  "dependencies": {
    "argon2": "^0.41.1",
    "compression": "^1.7.5",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dayjs": "^1.11.13",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "nanoid": "^3.3.8",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/compression": "^1.7.5",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.6",
    "typescript": "^5.7.3"
  }
}
