# ---------------------------------------------------------------------------
# AcademyOS frontend configuration
#
# Copy to .env.local for local overrides. Every VITE_* value is inlined into
# the JS bundle at BUILD time, so it is public: never put secrets here.
# ---------------------------------------------------------------------------

# Base origin of the Express API — no trailing slash, no /api suffix.
# The client appends /api itself, so this value plus /api/auth/login must be
# the real login endpoint.
#
#   VITE_API_URL=https://your-backend-domain.example.com
#
# Leave it EMPTY for local development: requests stay same-origin and the Vite
# dev server proxies /api -> http://127.0.0.1:4000 (see vite.config.ts).
#
# In Vercel set this under Settings -> Environment Variables for the
# Production (and Preview) environments, then redeploy: Vite bakes the value in
# at build time, so changing it requires a rebuild, not just a restart.
VITE_API_URL=
