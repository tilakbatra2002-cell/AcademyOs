# ----------------------------------------------------------------------------
# AcademyOS API configuration
# Copy to .env and adjust. Everything below has a safe development default.
# ----------------------------------------------------------------------------
NODE_ENV=development
PORT=4000

# --- Database --------------------------------------------------------------
# A replica set is REQUIRED (even a single-node one) because admissions,
# lead conversion and fee payments are written inside MongoDB transactions.
#   mongod --replSet rs0 ... then rs.initiate()
MONGO_URI=mongodb://127.0.0.1:27017/academyos?replicaSet=rs0

# --- Auth ------------------------------------------------------------------
# Use a long random value in production. JWTs are sent as httpOnly cookies.
JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_TTL=12h
JWT_REFRESH_TTL=7d

# --- Client / cookies ------------------------------------------------------
CLIENT_URL=http://localhost:5173
COOKIE_DOMAIN=
COOKIE_SECURE=false          # true in production (HTTPS only)
COOKIE_SAMESITE=lax          # none + secure=true when API and app are cross-site

# --- PRODUCTION (cross-site: SPA on Vercel, API on its own domain) ----------
# The SPA and the API are on different registrable domains, so the auth cookies
# are third-party and the browser will silently drop them unless BOTH of these
# are set. CLIENT_URL must be the exact frontend origin (no trailing slash) as
# it drives the CORS allowlist.
#
#   CLIENT_URL=https://academyos.webamazee.com
#   COOKIE_SECURE=true
#   COOKIE_SAMESITE=none
#
# If instead you host the API on a sibling subdomain (e.g. api.webamazee.com)
# the cookies stay first-party and you can keep SameSite=lax by setting:
#   COOKIE_DOMAIN=.webamazee.com
SESSION_IDLE_MINUTES=240

# --- Rate limiting ---------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=600
AUTH_RATE_LIMIT_MAX=30

# --- File storage ----------------------------------------------------------
# local | s3 | cloudinary. Video/document binaries NEVER go into MongoDB.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
STORAGE_SIGNED_URL_TTL=3600

# S3 / any S3-compatible service (MinIO, R2, Spaces)
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Messaging -------------------------------------------------------------
# When unset, messages are recorded in communication history with status
# NOT_CONFIGURED. The app never claims a delivery that did not happen.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMS_PROVIDER=
SMS_API_KEY=
WHATSAPP_PROVIDER=
WHATSAPP_API_KEY=

# --- Payments --------------------------------------------------------------
# manual | razorpay | stripe. "manual" needs no credentials: staff record
# cash/UPI/bank payments and receipts are generated locally.
PAYMENT_PROVIDER=manual
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
STRIPE_SECRET_KEY=

# --- SaaS ------------------------------------------------------------------
TRIAL_DAYS=14
